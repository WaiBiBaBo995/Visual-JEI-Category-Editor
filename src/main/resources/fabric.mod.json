{
  "schemaVersion": 1,
  "id": "vjce",
  "version": "${version}",
  "name": "Visual JEI Category Editor",
  "description": "Client-side visual JEI category and display recipe editor for Minecraft 1.20.1.",
  "authors": ["pureneko"],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["com.pureneko.vjce.VisualJeiCategoryEditor"],
    "jei_mod_plugin": ["com.pureneko.vjce.integration.VjceJeiPlugin"]
  },
  "mixins": ["vjce.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=17",
    "ldlib": [">=${ldlib}", "1.0.52.a"],
    "jei": ">=${jei}"
  }
}
